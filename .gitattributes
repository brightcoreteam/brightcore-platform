# Normalise line endings so the repository does not churn on Windows checkouts.
* text=auto eol=lf

# Binary assets — never touch these
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.woff2 binary

# Keep the deploy workflow and shell-ish files on LF
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
